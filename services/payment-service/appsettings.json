{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "BuildNexusAuth",
    "Audience": "BuildNexusServices",
    "SigningKey": ""
  },
  "Kafka": {
    "BootstrapServers": "localhost:29092",
    "ConsumerGroupId": "payment-service",
    "MessageTimeoutMs": 5000
  },
  "Outbox": {
    "PollIntervalSeconds": 5,
    "BatchSize": 50
  },
  "ConnectionStrings": {
    "PaymentDb": "Server=localhost;Port=3311;Database=buildnexus_payment_db;User Id=buildnexus;Password=buildnexus-dev;"
  }
}

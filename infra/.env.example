# Copy to infra/.env — `cp .env.example .env` — and you are ready to run.
#
# The values below are real and working ON PURPOSE: this is a local-development
# stack only, so every teammate gets an identical, functioning setup with no
# out-of-band secret sharing. NONE of these values may ever be used in a
# deployed environment; the production signing key is issued through GitHub
# Secrets (US-35) and never appears in any file in this repository.

# --- User Service database ---
USER_DB_ROOT_PASSWORD=buildnexus-root-dev
USER_DB_USER=buildnexus
USER_DB_PASSWORD=buildnexus-dev

# --- JWT: shared convention ---
# Issuer, audience and signing key must be IDENTICAL in every service that
# validates a BuildNexus token — the User Service that signs them and the API
# Gateway that checks them. The names use the double underscore that ASP.NET
# Core maps onto the Jwt: configuration section.
Jwt__Issuer=BuildNexusAuth
Jwt__Audience=BuildNexusServices
Jwt__SigningKey=2C7UiWaeWhpY/0owjjlGvyqoq+jEHSLFc53Nyy6Hmuk1YYjjPa7CazqlbUz4XFBa

# --- API Gateway ---
# The origin the React app is served from. CORS is configured once, at the
# gateway, so this is the only place an origin is declared for the whole system.
FRONTEND_ORIGIN=http://localhost:5173

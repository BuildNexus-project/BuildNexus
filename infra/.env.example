# Copy to infra/.env — `cp .env.example .env` — and you are ready to run.
#
# The values below are real and working ON PURPOSE: this is a local-development
# stack only, so every teammate gets an identical, functioning setup with no
# out-of-band secret sharing. NONE of these values may ever be used in a
# deployed environment; the production signing key is issued through GitHub
# Secrets (US-35) and never appears in any file in this repository.

# --- User Service database ---
USER_DB_ROOT_PASSWORD=buildnexus-root-dev
USER_DB_USER=buildnexus
USER_DB_PASSWORD=buildnexus-dev

# --- Project Service database ---
# A separate MySQL container from the User Service's: one schema per service,
# and the account is scoped to that one database. Published on host port 3307,
# since user-db already has 3306.
PROJECT_DB_ROOT_PASSWORD=buildnexus-root-dev
PROJECT_DB_USER=buildnexus
PROJECT_DB_PASSWORD=buildnexus-dev

# --- Design Service database ---
# Its own MySQL container, same as above. Published on host port 3309, since
# 3306/3307 are taken and the local override moves user-db to 3308.
DESIGN_DB_ROOT_PASSWORD=buildnexus-root-dev
DESIGN_DB_USER=buildnexus
DESIGN_DB_PASSWORD=buildnexus-dev

# --- Construction Service database ---
# Its own MySQL container, same as above. Published on host port 3310, since
# 3306-3309 are taken by the four services before it.
CONSTRUCTION_DB_ROOT_PASSWORD=buildnexus-root-dev
CONSTRUCTION_DB_USER=buildnexus
CONSTRUCTION_DB_PASSWORD=buildnexus-dev

# --- JWT: shared convention ---
# Issuer, audience and signing key must be IDENTICAL in every service that
# validates a BuildNexus token — the User Service that signs them and the API
# Gateway that checks them. The names use the double underscore that ASP.NET
# Core maps onto the Jwt: configuration section.
Jwt__Issuer=BuildNexusAuth
Jwt__Audience=BuildNexusServices
Jwt__SigningKey=2C7UiWaeWhpY/0owjjlGvyqoq+jEHSLFc53Nyy6Hmuk1YYjjPa7CazqlbUz4XFBa

# --- Internal service-to-service calls (US-11) ---
# Presented in the X-Internal-Api-Key header by a service calling another
# service's /api/internal endpoints — e.g. the Design Service looking up an
# Architect's email to notify them. IDENTICAL wherever it is both checked (the
# User Service, which owns the only such endpoint so far) and sent (every
# service that calls one).
InternalService__ApiKey=9fQe1S02b7ZvXk4mWn8pLr6tYc3JhAg5DzUo0iVfBs2NxTqE7wRlKy

# --- API Gateway ---
# The origin the React app is served from. CORS is configured once, at the
# gateway, so this is the only place an origin is declared for the whole system.
FRONTEND_ORIGIN=http://localhost:5173

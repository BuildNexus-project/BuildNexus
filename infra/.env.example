# Copy to infra/.env and fill in. infra/.env is git-ignored — never commit real values.

# --- User Service database ---
USER_DB_ROOT_PASSWORD=change-me-root
USER_DB_USER=buildnexus
USER_DB_PASSWORD=change-me

# --- JWT (shared by the User Service and the API Gateway) ---
# Issuer and audience must match on both sides, and both must load the SAME
# signing key. Minimum 32 bytes; generate one with:
#   openssl rand -base64 48
JWT_ISSUER=buildnexus-user-service
JWT_AUDIENCE=buildnexus-api
JWT_SIGNING_KEY=
JWT_LIFETIME_MINUTES=60

<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="BuildNexus Microservice Load Test Plan (SE3112)" enabled="true">
      <stringProp name="TestPlan.comments">SE3112. Four workloads: project creation, design upload, Client sessions across Project/Payment/Construction, and Admin construction reports. All targets default to the API gateway. run-performance-tests.sh prepares populated fixtures before measurement and supplies their CSV path. The Client session logs in on every iteration, then reads its own project, billing and progress. Run from this directory in non-GUI mode with the runner; see README.md.</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
        <collectionProp name="Arguments.arguments">
          <elementProp name="GATEWAY_PROTOCOL" elementType="Argument">
            <stringProp name="Argument.name">GATEWAY_PROTOCOL</stringProp>
            <stringProp name="Argument.value">${__P(gateway_protocol,http)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="GATEWAY_HOST" elementType="Argument">
            <stringProp name="Argument.name">GATEWAY_HOST</stringProp>
            <stringProp name="Argument.value">${__P(gateway_host,localhost)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="GATEWAY_PORT" elementType="Argument">
            <stringProp name="Argument.name">GATEWAY_PORT</stringProp>
            <stringProp name="Argument.value">${__P(gateway_port,5000)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="AUTH_PROTOCOL" elementType="Argument">
            <stringProp name="Argument.name">AUTH_PROTOCOL</stringProp>
            <stringProp name="Argument.value">${__P(auth_protocol,http)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="AUTH_HOST" elementType="Argument">
            <stringProp name="Argument.name">AUTH_HOST</stringProp>
            <stringProp name="Argument.value">${__P(auth_host,localhost)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="AUTH_PORT" elementType="Argument">
            <stringProp name="Argument.name">AUTH_PORT</stringProp>
            <stringProp name="Argument.value">${__P(auth_port,5000)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="PROJECT_PROTOCOL" elementType="Argument">
            <stringProp name="Argument.name">PROJECT_PROTOCOL</stringProp>
            <stringProp name="Argument.value">${__P(project_protocol,http)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="PROJECT_HOST" elementType="Argument">
            <stringProp name="Argument.name">PROJECT_HOST</stringProp>
            <stringProp name="Argument.value">${__P(project_host,localhost)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="PROJECT_PORT" elementType="Argument">
            <stringProp name="Argument.name">PROJECT_PORT</stringProp>
            <stringProp name="Argument.value">${__P(project_port,5000)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="DESIGN_PROTOCOL" elementType="Argument">
            <stringProp name="Argument.name">DESIGN_PROTOCOL</stringProp>
            <stringProp name="Argument.value">${__P(design_protocol,http)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="DESIGN_HOST" elementType="Argument">

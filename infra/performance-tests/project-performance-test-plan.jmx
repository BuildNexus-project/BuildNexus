                  <stringProp name="Argument.value">{&quot;name&quot;:&quot;Load Test Home ${__threadNum}-${__Random(1,999999)}&quot;,&quot;location&quot;:&quot;1 Load Test Rd, Colombo&quot;,&quot;landSizePerches&quot;:10.5,&quot;budget&quot;:5000000.00,&quot;floors&quot;:2,&quot;bedrooms&quot;:3,&quot;bathrooms&quot;:2,&quot;garageSpaces&quot;:1,&quot;otherRequirements&quot;:&quot;SCRUM-45 performance test fixture&quot;}</stringProp>

<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BuildNexus.ApiGateway</RootNamespace>
    <AssemblyName>BuildNexus.ApiGateway</AssemblyName>
    <UserSecretsId>ab5ad8e3-efe9-4017-b023-d55976923524</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- YARP is the whole gateway: there is no controller here, only the
         reverse proxy driven by the ReverseProxy section of appsettings.json. -->
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
    <!-- Same version the User Service validates with, so the two sides of the
         shared JWT convention cannot drift apart across a package upgrade. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
  </ItemGroup>

</Project>

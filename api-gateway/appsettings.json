{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information"
    }
  },
  "AllowedHosts": "*",

  // The single origin the React app is served from during local development.
  // Deployed environments override this with Cors__AllowedOrigins__0.
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },

  "ReverseProxy": {
    // One route per public path prefix. Every prefix the frontend calls must
    // appear here — anything unmatched gets a 404 from the gateway and never
    // reaches a service, which is the point of a single entry point.
    "Routes": {
      "user-auth": {
        "ClusterId": "user",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "user-users": {
        "ClusterId": "user",
        "Match": { "Path": "/api/users/{**catch-all}" }
      },
      "project": {
        "ClusterId": "project",
        "Match": { "Path": "/api/projects/{**catch-all}" }
      },
      "design": {
        "ClusterId": "design",
        "Match": { "Path": "/api/designs/{**catch-all}" }
      },
      "design-documents": {
        "ClusterId": "design",
        "Match": { "Path": "/api/documents/{**catch-all}" }
      },
      "construction": {
        "ClusterId": "construction",
        "Match": { "Path": "/api/construction/{**catch-all}" }
      },
      "payment": {
        "ClusterId": "payment",
        "Match": { "Path": "/api/payments/{**catch-all}" }
      }
    },

    // Addresses below are the local `dotnet run` ports, matching each service's
    // launchSettings.json. Cluster ids are deliberately free of hyphens so the
    // per-environment override reads as a plain environment variable name:
    //   ReverseProxy__Clusters__user__Destinations__primary__Address
    "Clusters": {
      "user": {
        "Destinations": {
          "primary": { "Address": "http://localhost:5001/" }
        }
      },
      "project": {
        "Destinations": {
          "primary": { "Address": "http://localhost:5002/" }
        }
      },
      "design": {
        "Destinations": {
          "primary": { "Address": "http://localhost:5003/" }
        }
      },
      "construction": {
        "Destinations": {
          "primary": { "Address": "http://localhost:5004/" }
        }
      },
      "payment": {
        "Destinations": {
          "primary": { "Address": "http://localhost:5005/" }
        }
      }
    }
  }
}
